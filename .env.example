SECRET_KEY=HIER_LANGE_ZEICHENKETTE
HTTPS=0

# nur bei 'podman compose' / 'docker compose': 127.0.0.1 = nur der Reverse Proxy erreicht den Port
BIND=127.0.0.1

# Auf dem Schulserver hinter dem Reverse Proxy unter /postfach: HTTPS=1 und
# COOKIE_PATH=/postfach
# COOKIE_PATH=/postfach

# E-Mail-Benachrichtigung (SMTP-Daten von der Schul-IT, nie ins Repository!)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls | ssl | none
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=postfach@beispiel-schule.at
# BASE_URL=https://service.beispiel-schule.at/postfach

# Automatischer Versand der Sammelmail: taeglich um diese Uhrzeit (Standard 07:00, Zeitzone Europe/Vienna).
# Gibt es nichts Neues, wird nichts verschickt. Mehrere Zeiten: NOTIFY_AT=07:00,15:00
# Funktioniert nur, wenn SMTP_HOST und SMTP_FROM gesetzt sind. Leer lassen = kein automatischer Versand.
# NOTIFY_AT=07:00
# NOTIFY_TZ=Europe/Vienna
